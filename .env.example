# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=your_key_here

# Optional
RESEARCH_AGENT_MODEL=claude-sonnet-5-5

# Optional: your model's prices in dollars per million tokens, to show run cost
RESEARCH_AGENT_PRICE_IN=
RESEARCH_AGENT_PRICE_OUT=

# Free alternative to Claude (example: Google Gemini's OpenAI-compatible endpoint)
# RESEARCH_AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# RESEARCH_AGENT_API_KEY=your_key_here
# RESEARCH_AGENT_MODEL=gemini-3.8-flash
